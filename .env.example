# Server-side only. Never add a VITE_ prefix to provider credentials.
ELEVENLABS_API_KEY=
# Optional when your MCP agent supplies the complete script:
PAPER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto prefers Gemini when its key is configured, otherwise Paper.
BRAINROTTEN_SCRIPT_PROVIDER=auto
# Google Images is the keyless default, adapted from Pixd.
# Optional legacy providers, selected explicitly:
# BRAINROTTEN_IMAGE_SEARCH_PROVIDER=google
# BRAINROTTEN_IMAGE_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=
# BRAINROTTEN_IMAGE_SEARCH_PROVIDER=commons
# Optional public Cognito configuration; Studio Settings can save these instead:
# COGNITO_DOMAIN=https://YOUR_PREFIX.auth.ap-south-1.amazoncognito.com
# COGNITO_USER_POOL_ID=ap-south-1_Example
# COGNITO_CLIENT_ID=YOUR_PUBLIC_APP_CLIENT_ID
# The private MCP token is created in the local data directory. Copy it from Studio.
# Optional local overrides:
# BRAINROT_PORT=3001
# BRAINROT_DATA_DIR=/absolute/private/data/directory
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
